{
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "false"
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(npm test:*)",
      "Bash(npm run:*)",
      "Bash(npx vitest:*)",
      "Bash(npx prettier:*)",
      "Bash(python -m black:*)",
      "Bash(python -m pytest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(wc:*)",
      "Bash(echo:*)",
      "Bash(date:*)",
      "Bash(aws logs:*)"
    ],
    "deny": [
      "Bash(sudo rm:*)",
      "Bash(mkfs:*)"
    ],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-start.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/bash-safety.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/write-safety.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/changelog-validator.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/log-commands.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/post-commit-complete.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/format-python.sh",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/format-typescript.sh",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/format-json.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
